# Copia este archivo como .env y completa tus valores.
# El archivo .env está en .gitignore: tu API key nunca se sube al repositorio.
# Las variables definidas en la terminal ($env:VARIABLE = ...) tienen prioridad sobre este archivo.

# --- LangSmith: observabilidad, monitoreo y evaluación ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=asistente-faena
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # solo si tu cuenta es de la región EU o autoalojada

# --- Modelos ---
# offline = respuestas rápidas sin Ollama (recomendado para la demo); auto = usa Ollama si está disponible
MODO_LLM=offline
# MODO_EMBEDDINGS=auto
# MODELO_GENERADOR=qwen3.5:0.8b
# UMBRAL_ABSTENCION=0.30
